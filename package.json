{
  "name": "vue-pwa-starter",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "check": "run-p --continue-on-error --aggregate-output --print-label lint:check format:check type-check test:unit test:arch test:lint-rules knip",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "start:playwright:webserver": "vite preview --host 127.0.0.1 --port 5678 --strictPort",
    "test": "vitest run --project=default",
    "test:watch": "vitest --project=default",
    "test:unit": "vitest run --project=unit",
    "test:a11y": "vitest run --project=a11y",
    "test:touch": "vitest run --project=touch",
    "test:visual": "vitest run --project=visual",
    "test:visual:update": "vitest run --project=visual --update",
    "test:arch": "vitest run --project=arch",
    "test:lint-rules": "vitest run --project=lint-rules",
    "ast": "node --experimental-strip-types tools/oxlint/ast.ts",
    "test:coverage": "vitest run --project=default --coverage",
    "test:mutation": "stryker run",
    "test:e2e": "run-s build-only test:e2e:prebuilt",
    "test:e2e:prebuilt": "bddgen && playwright test",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix --ignore-path .gitignore",
    "lint:oxlint:check": "oxlint . --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix --cache",
    "lint:eslint:check": "eslint . --cache --max-warnings 0",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "lint": "run-s lint:oxlint lint:eslint lint:md",
    "lint:check": "run-s lint:oxlint:check lint:eslint:check lint:md",
    "format": "prettier --write \"**/*.{ts,mts,tsx,vue,js,mjs,cjs,json,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,mts,tsx,vue,js,mjs,cjs,json,css,yml,yaml}\"",
    "knip": "run-s knip:dev knip:production",
    "knip:dev": "knip",
    "knip:production": "knip --production --exclude dependencies",
    "size-limit": "size-limit",
    "prepare": "husky"
  },
  "dependencies": {
    "@effect/atom-vue": "catalog:frontend",
    "@huggingface/transformers": "catalog:frontend",
    "@lucide/vue": "catalog:ui",
    "@tailwindcss/vite": "catalog:ui",
    "@vueuse/core": "catalog:frontend",
    "class-variance-authority": "catalog:ui",
    "clsx": "catalog:ui",
    "dexie": "catalog:frontend",
    "effect": "catalog:frontend",
    "reka-ui": "catalog:ui",
    "tailwind-merge": "catalog:ui",
    "tailwindcss": "catalog:ui",
    "vue": "catalog:frontend",
    "vue-i18n": "catalog:frontend",
    "vue-router": "catalog:frontend",
    "web-vitals": "catalog:frontend"
  },
  "devDependencies": {
    "@e18e/eslint-plugin": "catalog:lint",
    "@effect/vitest": "catalog:testing",
    "@oxlint/plugins": "catalog:lint",
    "@playwright/test": "catalog:testing",
    "@size-limit/file": "catalog:lint",
    "@stryker-mutator/api": "catalog:testing",
    "@stryker-mutator/core": "catalog:testing",
    "@stryker-mutator/vitest-runner": "catalog:testing",
    "@tsconfig/node22": "catalog:build",
    "@types/node": "catalog:build",
    "@vite-pwa/assets-generator": "catalog:build",
    "@vitejs/plugin-vue": "catalog:build",
    "@vitest/browser": "catalog:testing",
    "@vitest/browser-playwright": "catalog:testing",
    "@vitest/coverage-v8": "catalog:testing",
    "@vue/eslint-config-prettier": "catalog:lint",
    "@vue/eslint-config-typescript": "catalog:lint",
    "@vue/tsconfig": "catalog:build",
    "archunit": "catalog:testing",
    "axe-core": "catalog:testing",
    "eslint": "catalog:lint",
    "eslint-plugin-oxlint": "catalog:lint",
    "eslint-plugin-regexp": "catalog:lint",
    "eslint-plugin-vue": "catalog:lint",
    "fake-indexeddb": "catalog:testing",
    "husky": "catalog:build",
    "jiti": "catalog:build",
    "knip": "catalog:lint",
    "lint-staged": "catalog:lint",
    "markdownlint-cli2": "catalog:lint",
    "npm-run-all2": "catalog:build",
    "oxlint": "catalog:lint",
    "playwright": "catalog:testing",
    "playwright-bdd": "catalog:testing",
    "prettier": "catalog:lint",
    "size-limit": "catalog:lint",
    "tw-animate-css": "catalog:ui",
    "typescript": "catalog:build",
    "vite": "catalog:build",
    "vite-plugin-pwa": "catalog:build",
    "vite-plugin-vue-devtools": "catalog:build",
    "vitest": "catalog:testing",
    "vitest-browser-vue": "catalog:testing",
    "vue-tsc": "catalog:build",
    "workbox-window": "catalog:build"
  },
  "size-limit": [
    {
      "name": "production JavaScript",
      "path": [
        "dist/assets/*.js",
        "!dist/assets/ai-*.js"
      ],
      "limit": "210 kB"
    },
    {
      "name": "vision-model runtime (lazy, photo scan only)",
      "path": "dist/assets/ai-*.js",
      "limit": "1.6 MB"
    }
  ],
  "lint-staged": {
    "*.{ts,mts,tsx,vue}": [
      "oxlint --fix --ignore-path .gitignore --no-error-on-unmatched-pattern",
      "eslint --fix --cache",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,css,yml,yaml}": "prettier --write",
    "*.md": "markdownlint-cli2"
  }
}
