# Copy to .env.local (gitignored) to turn on development telemetry export.
#
# Every db operation already opens a named Effect span and every reported
# failure already emits an annotated log record — see src/lib/observability.ts.
# Setting this gives them a collector to land in; leaving it unset exports
# nothing. It has no effect on a production build, where the exporter is dead
# code.
#
# `/_otlp` is proxied to http://localhost:4318 by the Vite dev server, which
# keeps the request same-origin so the collector needs no CORS setup. Override
# the proxy target with OTLP_ENDPOINT if your collector is elsewhere.
#
# A collector to point it at:
#   docker run --rm -p 16686:16686 -p 4318:4318 jaegertracing/all-in-one
# then open http://localhost:16686 and pick the "vue-pwa-starter" service.
VITE_OTLP_URL=/_otlp
