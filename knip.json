{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "treatConfigHintsAsErrors": true,
  "treatTagHintsAsErrors": true,
  "entry": ["index.html"],
  "project": ["src/**/*.ts", "src/**/*.vue", "src/**/*.css"],
  // src/components/*/*/** — a compound primitive reaches the app through its
  // barrel, so knip sees each part as unreferenced.
  //
  // AtomTextarea — the primitive library is the starter's product, not part of
  // any one feature, and this is the only atom no screen happens to render
  // since the notes worked example was removed. It is graded by the arch tier
  // like every other primitive (__tests__/architecture/primitives.test.ts,
  // touchConventions.test.ts); drop this entry the day a screen binds a
  // multi-line field. AtomInput came off this list with the benchmark sheet.
  "ignore": ["src/components/*/*/**", "src/components/atoms/AtomTextarea.vue"],
  "vitest": {
    "entry": ["src/__tests__/**/*.spec.ts", "src/__tests__/**/*.test.ts"]
  }
}
