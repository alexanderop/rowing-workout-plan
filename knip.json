{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "treatConfigHintsAsErrors": true,
  "treatTagHintsAsErrors": true,
  "entry": ["index.html"],
  "project": ["src/**/*.ts", "src/**/*.vue", "src/**/*.css"],
  "ignore": ["src/components/*/*/**"],
  "vitest": {
    "entry": ["src/__tests__/**/*.spec.ts", "src/__tests__/**/*.test.ts"]
  }
}
